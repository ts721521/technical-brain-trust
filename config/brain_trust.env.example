# Brain Trust runtime model mapping
# 使用前：cp config/brain_trust.env.example config/brain_trust.env
# 然后在 shell 中 source config/brain_trust.env

export BT_ARCHITECT_MODEL="openai-codex/gpt-5.3-codex"
export BT_ARCHITECT_FALLBACK_1="zai/glm-5"
export BT_ARCHITECT_FALLBACK_2="google-gemini-cli/gemini-3.1-pro-preview"
export BT_ARCHITECT_FALLBACK_3="bailian/qwen3.5-plus"

export BT_CRITIC_MODEL="zai/glm-5"
export BT_CRITIC_FALLBACK_1="openai-codex/gpt-5.3-codex"
export BT_CRITIC_FALLBACK_2="google-gemini-cli/gemini-3-pro-preview"
export BT_CRITIC_FALLBACK_3="bailian/qwen3-max-2026-01-23"

export BT_INNOVATOR_MODEL="google-gemini-cli/gemini-3.1-pro-preview"
export BT_INNOVATOR_FALLBACK_1="openai-codex/gpt-5.3-codex"
export BT_INNOVATOR_FALLBACK_2="zai/glm-4.7"
export BT_INNOVATOR_FALLBACK_3="bailian/kimi-k2.5"

# Phase2 runtime convergence (optional, defaults will be used when omitted)
export BT_PANGU_MODEL="bailian/qwen3-coder-plus"
export BT_PANGU_FALLBACK_1="openai-codex/gpt-5.3-codex"
export BT_PANGU_FALLBACK_2="zai/glm-5"
export BT_PANGU_FALLBACK_3="bailian/qwen3.5-plus"

export BT_SCHOLAR_MODEL="zai/glm-5"
export BT_SCHOLAR_FALLBACK_1="openai-codex/gpt-5.3-codex"
export BT_SCHOLAR_FALLBACK_2="google-gemini-cli/gemini-3.1-pro-preview"
export BT_SCHOLAR_FALLBACK_3="bailian/qwen3.5-plus"

export BT_FEIGE_MODEL="google-gemini-cli/gemini-2.0-flash"
export BT_FEIGE_FALLBACK_1="bailian/qwen3.5-plus"
export BT_FEIGE_FALLBACK_2="openai-codex/gpt-5.3-codex"
export BT_FEIGE_FALLBACK_3="zai/glm-5"

# 业务产物落盘根目录（默认外置盘）
export BT_DOCS_ROOT="/Volumes/TB512/3_ClawDocs"
# 团队目录（须符合 team-<kebab>）
export BT_TEAM_ID="team-brain-trust"
